{# This file is a template for the config file #}
{# It is automatically generated #}

addresses = [
{% for host in groups['kcensus_nodes'] %}
  {% if host == inventory_hostname %}
    "0.0.0.0:8000"
  {% else %}
    "{{ hostvars[host]['ansible_host'] | default(host) }}:8000"
  {% endif %}{% if not loop.last %},{% endif %}
{% endfor %}
]

regions = {{ dynamic_regions | to_json }}

raw_latencies = {{ dynamic_latency_matrix | to_json }}